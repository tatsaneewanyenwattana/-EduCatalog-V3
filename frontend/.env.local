# =======================================================
# EduCatalog V3 — Frontend Environment Variables (Next.js)
# -------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# ห้าม commit .env.local เข้า git (กฎ A6)
#
# สำคัญ: ตัวแปร NEXT_PUBLIC_* จะถูกส่งออกไปบน browser
#        ห้ามใส่ secret/api key ลงในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_
# =======================================================


# -------------------------------------------------------
# Application
# -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EduCatalog
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -------------------------------------------------------
# Backend API
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1
# timeout ของ axios/fetch (มิลลิวินาที)
NEXT_PUBLIC_API_TIMEOUT_MS=15000


# -------------------------------------------------------
# Feature Flags — sync กับ backend (CACHE_TTL_FLAGS)
# -------------------------------------------------------
# วินาที — ตรงกับ /feature-flags ที่ backend cache 60s
NEXT_PUBLIC_FEATURE_FLAGS_TTL=60


# -------------------------------------------------------
# Upload constraint (UI hint) — sync กับ backend
# -------------------------------------------------------
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=100
NEXT_PUBLIC_UPLOAD_ALLOWED_FORMATS=csv,xlsx,xls,json


# -------------------------------------------------------
# Pagination (UI default) — sync กับ backend
# -------------------------------------------------------
NEXT_PUBLIC_PAGINATION_DEFAULT_LIMIT=20
NEXT_PUBLIC_PAGINATION_MAX_LIMIT=100
