{
  "name": "educatalog-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "EduCatalog V3 — Thai Education Data Catalog (Next.js 14)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:host": "next dev --hostname 127.0.0.1 --port 3001",
