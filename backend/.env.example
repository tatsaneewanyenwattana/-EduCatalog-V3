# =======================================================
# EduCatalog V3 — Backend Environment Variables
# -------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (โดยเฉพาะ secret)
# ห้าม commit ไฟล์ .env เข้า git (กฎ A6)
# ทุกค่าต้องอ่านผ่าน core/config.py เสมอ (กฎ A5)
# =======================================================


# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME=EduCatalog
APP_VERSION=v1
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# secret สำหรับ sign cookie / session (สุ่มยาว >= 32 ตัวอักษร)
SECRET_KEY=


# -------------------------------------------------------
# Database — PostgreSQL 16
# -------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=educatalog
POSTGRES_PASSWORD=
POSTGRES_DB=educatalog

# ใช้ asyncpg driver เพราะ SQLAlchemy 2.0 + FastAPI async
DATABASE_URL=postgresql+asyncpg://educatalog:@localhost:5432/educatalog

# Connection pool — ค่ามาตรฐานจากกฎ CONCURRENCY
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30


# -------------------------------------------------------
# Redis 7 — cache + rate limit + feature flags
# -------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0


# -------------------------------------------------------
# Celery Queue (ใช้ Redis เป็น broker)
# -------------------------------------------------------
# แยก db ออกจาก cache เพื่อกัน key ชนกัน
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# -------------------------------------------------------
# Elasticsearch 8 — full-text search dataset
# -------------------------------------------------------
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=elastic
ES_PASSWORD=
ES_INDEX_DATASETS=datasets


# -------------------------------------------------------
# MinIO — S3-compatible object storage
# -------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# dev = false, prod = true (HTTPS)
MINIO_SECURE=false
# bucket ปลายทางหลังผ่าน pipeline ครบ (กฎ D6)
MINIO_BUCKET_DATASETS=datasets
# bucket ชั่วคราวก่อน ClamAV scan
MINIO_BUCKET_TEMP=datasets-temp


# -------------------------------------------------------
# JWT — Authentication (กฎ D2)
# -------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7


# -------------------------------------------------------
# Encryption — Fernet สำหรับ PII (กฎ D7)
# -------------------------------------------------------
# สร้างด้วย: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# -------------------------------------------------------
# Email — Resend
# -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@educatalog.local
EMAIL_FROM_NAME=EduCatalog


# -------------------------------------------------------
# ClamAV — virus scan ก่อน publish (กฎ D6 ขั้น 3)
# -------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310


# -------------------------------------------------------
# CKAN — sync ไป data.go.th (feature flag: ckan_sync_enabled)
# -------------------------------------------------------
CKAN_URL=https://data.go.th
CKAN_API_KEY=


# -------------------------------------------------------
# File Upload (กฎ D6)
# -------------------------------------------------------
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_FORMATS=csv,xlsx,xls,json


# -------------------------------------------------------
# Rate Limit (กฎ D10)
# -------------------------------------------------------
RATE_LIMIT_API_PER_MIN=100
RATE_LIMIT_DOWNLOAD_FILES_PER_HOUR=20
RATE_LIMIT_DOWNLOAD_MB_PER_HOUR=500


# -------------------------------------------------------
# Cache TTL (วินาที) — กฎ C5
# -------------------------------------------------------
CACHE_TTL_SEARCH=300
CACHE_TTL_DATASET=600
CACHE_TTL_SCHEMA=1800
CACHE_TTL_FLAGS=60


# -------------------------------------------------------
# Pagination (กฎ C6)
# -------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100


# -------------------------------------------------------
# Security
# -------------------------------------------------------
# bcrypt rounds — ค่าเหมาะสมระหว่างความเร็วกับความปลอดภัย
BCRYPT_ROUNDS=12

# origins ที่ frontend อนุญาตให้เรียก API ได้ (comma separated)
CORS_ORIGINS=http://localhost:3000


# -------------------------------------------------------
# Logging (กฎ H6 — JSON format)
# -------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=json
