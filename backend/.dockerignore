# =======================================================
# EduCatalog V3 — Backend .dockerignore
# -------------------------------------------------------
# ลด build context ที่ส่งให้ docker daemon → build เร็วขึ้น
# และกันไฟล์ sensitive / ขยะ ไม่ให้หลุดเข้า image
# =======================================================


# -------------------------------------------------------
# Secrets — กันเด็ดขาด (กฎ A6)
# .env หลุดเข้า image = secret รั่วทุก container ที่ pull image
# -------------------------------------------------------
.env
.env.*
!.env.example


# -------------------------------------------------------
# Python bytecode — สร้างใหม่ทุกครั้งที่รัน
# ถ้า copy ไป image จะใช้ bytecode ของ host (อาจคนละ arch)
# ทำให้ container error แบบหา root cause ยาก
# -------------------------------------------------------
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
*.so


# -------------------------------------------------------
# Test artifacts — ไม่จำเป็นต้องใช้ใน image
# .coverage มี path ของ host ฝังอยู่ → ใช้ใน container ไม่ได้
# -------------------------------------------------------
.pytest_cache
.coverage
.coverage.*
htmlcov
coverage.xml
.tox
.nox


# -------------------------------------------------------
# Alembic — เก็บ .py ไว้ ทิ้ง .pyc/__pycache__ ภายใน versions/
# (migration file ต้อง bake เข้า image เพื่อรันตอน deploy)
# -------------------------------------------------------
alembic/versions/__pycache__
alembic/versions/*.pyc


# -------------------------------------------------------
# Tests — ไม่ deploy ไป prod image
# ขนาดลดลง + ลด attack surface (กฎ E)
# หมายเหตุ: dev compose ใช้ bind mount → tests/ ยังเข้าถึงได้ตอน dev
# -------------------------------------------------------
tests
tests/


# -------------------------------------------------------
# Git metadata — ไม่ใช้ใน runtime
# .git อาจมีขนาดใหญ่ + ทำให้ image hash เปลี่ยนทุก commit ที่ไม่เกี่ยว
# -------------------------------------------------------
.git
.gitignore
.gitattributes


# -------------------------------------------------------
# Docs — อ่านจาก repo ก็พอ ไม่ต้องอยู่ใน image
# -------------------------------------------------------
README.md
README.rst
docs
docs/
*.md
!alembic/README


# -------------------------------------------------------
# IDE & Editor — config เฉพาะเครื่อง dev
# ถ้า copy เข้า image จะทำให้ image แต่ละคนต่างกัน (build cache miss)
# -------------------------------------------------------
.vscode
.idea
*.swp
*.swo
*~
.DS_Store


# -------------------------------------------------------
# Virtual environments — image มี Python ของตัวเอง
# ถ้า copy venv ของ host เข้าไป จะแย่งกันกับ pip install ใน Dockerfile
# -------------------------------------------------------
venv
.venv
env
ENV
.python-version


# -------------------------------------------------------
# Logs & local data — ไม่ใช้ใน build
# log path ใน prod อยู่ที่ stdout (กฎ H4) ไม่ใช่ไฟล์
# -------------------------------------------------------
*.log
logs
*.sqlite
*.sqlite3
*.db


# -------------------------------------------------------
# Docker files เอง — ไม่ต้อง copy เข้า image (จะ infinite recursion ขำๆ)
# -------------------------------------------------------
Dockerfile*
.dockerignore
docker-compose*.yml


# -------------------------------------------------------
# CI / build artifacts
# -------------------------------------------------------
.github
.gitlab-ci.yml
build
dist
*.egg-info
.mypy_cache
.ruff_cache
